FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY src/InstanaCrashLab/InstanaCrashLab.csproj src/InstanaCrashLab/
RUN dotnet restore src/InstanaCrashLab/InstanaCrashLab.csproj
COPY src/InstanaCrashLab/ src/InstanaCrashLab/
RUN dotnet publish src/InstanaCrashLab/InstanaCrashLab.csproj -c Release -o /out --no-restore

FROM mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated9.0 AS final
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true
COPY --from=build /out /home/site/wwwroot

